      --row-soft: var(--band-signal);
      --row-ink: var(--accent-signal-ink);
    }
    .business-table tbody tr:has(td:nth-child(4) .responsibility-mark.primary) {
      --row-accent: var(--diagram-architecture);
      --row-soft: var(--band-architecture);
      --row-ink: var(--accent-architecture-ink);
    }
    .business-table tbody tr:has(td:nth-child(5) .responsibility-mark.primary) {
      --row-accent: var(--diagram-review);
      --row-soft: var(--band-review);
      --row-ink: var(--accent-review-ink);
    }
    .business-table tbody tr.is-dim { opacity: .2; }
    .business-table tbody tr.is-match { background: var(--row-soft); }
    .business-table tbody tr.is-match th,
