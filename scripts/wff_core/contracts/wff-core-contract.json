  "contracts": [
    {"id": "agentic-boundary-contract", "responsibility": "Preserve Workflow, Agentic, Templates, and Evidence ownership boundaries."},
    {"id": "artifact-identity-contract", "responsibility": "Define storage-neutral artifact identities and bindings."},
    {"id": "claim-state-contract", "responsibility": "Carry generic claim envelopes and weakest-evidence ceilings."},
    {"id": "evidence-contract", "responsibility": "Represent bounded evidence identity, provenance, posture, and scope."},
    {"id": "extension-registration-contract", "responsibility": "Register declarative extensions without executable loading or Core-outward imports."},
    {"id": "handoff-contract", "responsibility": "Carry upstream authority, artifacts, evidence, unresolved items, and continuation decisions."},
    {"id": "lifecycle-route-contract", "responsibility": "Resolve external admission, continuation, return, and re-entry intents fail closed."},
    {"id": "phase-contract", "responsibility": "Define phase identity, structural admission, owner, and allowed continuation."},
    {"id": "reentry-return-contract", "responsibility": "Carry bounded remediation returns and PhaseX re-entry control packets."}
