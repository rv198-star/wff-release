    .business-table tbody td { padding: 12px 7px; border-left: 1px solid var(--diagram-line); text-align: center; }
    .business-table tbody td:last-child { padding: 12px; background: #f7fafb; text-align: left; }
    .business-table tbody tr {
      --row-accent: var(--diagram-business);
