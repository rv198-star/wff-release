    .role-heading b { color: var(--diagram-ink); font-size: 9px; }
    .role-heading span { font-size: 8px; font-weight: 400; }
    .use-case-code { display: inline-flex; padding: 1px 5px; border-radius: 2px; background: var(--row-accent); color: #fff; font-family: var(--code-font); font-size: 8px; font-weight: 760; }
    .use-case-name { display: block; margin-top: 5px; color: var(--diagram-ink); font-size: 13px; font-weight: 740; }
    .use-case-goal { display: block; margin-top: 3px; color: var(--diagram-ink-3); font-size: 9px; font-weight: 400; }

    .responsibility-mark {
      display: inline-grid;
      width: 19px;
      height: 19px;
      place-items: center;
      border: 1px solid var(--diagram-line-strong);
