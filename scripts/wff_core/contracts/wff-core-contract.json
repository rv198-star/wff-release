  "invariants": [
    {"id": "no-core-outward-dependency", "statement": "Core depends only on language/runtime primitives and its own public/internal types."},
    {"id": "declarative-extension-resolution", "statement": "Routing resolves descriptors and never imports implementations."},
    {"id": "unknown-route-fails-closed", "statement": "Unregistered routes are blocked rather than guessed."},
    {"id": "route-does-not-create-content-truth", "statement": "Route selection creates no product or engineering truth."},
    {"id": "phase-content-truth-remains-extension-owned", "statement": "Phase content truth remains owned by the phase extension."},
    {"id": "mechanical-checks-do-not-decide-semantic-sufficiency", "statement": "Structural checks do not establish semantic sufficiency."},
    {"id": "review-bound-remains-explicit", "statement": "Review-bound and unknown states remain explicit."},
    {"id": "documents-own-meaning", "statement": "Canonical artifacts own meaning."},
    {"id": "handoff-never-infers-missing-truth", "statement": "Missing upstream truth is never invented downstream."},
    {"id": "artifact-references-are-storage-neutral", "statement": "Artifact identity is independent of storage implementation."},
    {"id": "derived-index-is-not-source-truth", "statement": "Derived indexes never become semantic authority."},
    {"id": "evidence-does-not-create-content-truth", "statement": "Evidence proves or caps claims but creates no content truth."},
    {"id": "observed-inferred-unknown-remain-distinct", "statement": "Knowledge postures cannot be silently upgraded."},
    {"id": "proof-scope-is-explicit", "statement": "Evidence scope and provenance are explicit."},
    {"id": "weakest-evidence-caps-claim", "statement": "Claims cannot exceed weakest mandatory evidence."},
    {"id": "no-production-authority-by-default", "statement": "Core implies no production approval or owner sign-off."},
    {"id": "phase-specific-state-remains-extension-owned", "statement": "Phase-specific state vocabularies remain extension-owned."},
    {"id": "workflow-owns-order", "statement": "Workflow owns global order and interfaces."},
    {"id": "agentic-owns-semantic-judgment", "statement": "Agentic capability owners own semantic judgment."},
    {"id": "templates-do-not-decide", "statement": "Templates guide but do not decide."},
    {"id": "no-generic-plugin-framework", "statement": "Core provides no dynamic plugin lifecycle."},
    {"id": "extension-dependencies-point-inward", "statement": "Extensions consume Core; Core does not consume implementations."},
    {"id": "returns-are-control-not-import-cycles", "statement": "Return and re-entry are control packets, not import cycles."},
    {"id": "compatibility-facade-v18", "statement": "Current public identifiers remain compatible through v1.8 without explicit migration approval."}
  ],
