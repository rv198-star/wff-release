<!doctype html>
<html lang="@@WFF_LOCALE@@">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta name="referrer" content="no-referrer">
  <link rel="icon" href="data:,">
  <meta name="wff-human-review-artifact" content="human-review-dossier.v1">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'self' data: file:; font-src 'none'; connect-src 'none'; media-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'">
  <title>@@WFF_DOCUMENT_TITLE@@ | WFF 人类审阅 dossier</title>
  <style>
    :root {
      --canvas: #f7f5ef;
      --paper: #fffdf8;
      --ink: #27231e;
      --muted: #5d564c;
      --faint: #84796c;
      --rule: #e0d8ca;
      --rule-strong: #cbbda5;
      --accent-business: #ad562e;
      --accent-business-soft: #f7e5d8;
      --accent-business-ink: #823c1d;
      --accent-architecture: #356d86;
      --accent-architecture-soft: #e2edf2;
      --accent-architecture-ink: #28566b;
      --accent-signal: #c24e3a;
      --accent-signal-soft: #f9e1da;
      --accent-signal-ink: #913528;
      --accent-review: #9b6d16;
      --accent-review-soft: #f7eccd;
      --accent-review-ink: #704b0a;
      --band-business: #fbf1ea;
      --band-architecture: #edf3f5;
      --band-signal: #fbeeea;
      --band-review: #faf4e3;
      --green: var(--accent-review);
      --green-soft: var(--accent-review-soft);
      --blue: var(--accent-architecture);
      --blue-soft: var(--accent-architecture-soft);
      --amber: var(--accent-review);
      --focus: var(--accent-architecture);
      --body-font: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans CJK SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
      --display-font: "Noto Serif CJK SC", "Source Han Serif SC", "Songti SC", "STSong", "SimSun", Georgia, serif;
      --code-font: ui-monospace, "JetBrains Mono", SFMono-Regular, Menlo, Consolas, monospace;
      --content-width: 1400px;
      --reading-width: 820px;
      --nav-height: 48px;
      color: var(--ink);
      background: var(--canvas);
      font-family: var(--body-font);
    }

    * { box-sizing: border-box; letter-spacing: 0; }

    html { background: var(--canvas); }

    body {
      min-width: 1024px;
      margin: 0;
      background: var(--canvas);
      color: var(--ink);
      font-size: 16px;
      line-height: 1.78;
      text-rendering: optimizeLegibility;
    }

    a { color: var(--blue); text-decoration-thickness: 1px; text-underline-offset: 3px; }

    a:hover { color: #0a4978; }

    a:focus-visible,
    button:focus-visible,
    summary:focus-visible,
    [tabindex]:focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }

    .skip-link {
      position: fixed;
      z-index: 40;
      top: 8px;
      left: 12px;
      transform: translateY(-170%);
      padding: 9px 12px;
      background: #151d25;
      color: var(--paper);
      text-decoration: none;
    }

    .skip-link:focus { transform: translateY(0); }

    .reading-position {
      position: fixed;
      z-index: 35;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      transform: scaleX(0);
      transform-origin: left center;
      background: var(--green);
      pointer-events: none;
    }

    .masthead { border-bottom: 1px solid #4b4339; background: #24211d; color: #f6f0e4; }

    .masthead-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      width: min(var(--content-width), calc(100% - 64px));
      margin: 0 auto;
      min-height: 48px;
      padding: 0;
    }

    .masthead-label,
    .chapter-kicker {
      margin: 0;
      font-size: 11px;
      font-weight: 780;
      line-height: 1.35;
      text-transform: uppercase;
      font-family: var(--code-font);
      letter-spacing: 0;
    }

    .masthead-label { color: var(--accent-review); }
    .chapter-kicker { color: var(--chapter-accent-ink); }

    .case-name {
      max-width: 42ch;
      margin: 0;
      color: #d3c8b5;
      font-family: var(--code-font);
      font-size: 11px;
      overflow-wrap: anywhere;
      text-align: end;
    }

    .anchor-shell {
      position: sticky;
      z-index: 30;
      top: 0;
      min-height: var(--nav-height);
      border-bottom: 1px solid var(--rule-strong);
      background: rgb(255 254 250 / .97);
      box-shadow: 0 4px 14px rgb(73 61 43 / .05);
    }

    .anchor-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 20px;
      width: min(var(--content-width), calc(100% - 64px));
      margin: 0 auto;
    }

    .anchor-scroll { min-width: 0; overflow-x: auto; }

    .anchor-list {
      display: flex;
      width: max-content;
      min-height: var(--nav-height);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .anchor-list a {
      --nav-accent: var(--accent-review);
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: var(--nav-height);
      padding: 0 12px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 680;
      text-decoration: none;
      white-space: nowrap;
    }

    .anchor-list a[href="#prd"],
    .anchor-list a[href="#business-flow"] { --nav-accent: var(--accent-business); }

    .anchor-list a[href="#esp"],
    .anchor-list a[href="#architecture-flow"] { --nav-accent: var(--accent-architecture); }

    .anchor-list a[href="#action-cards"],
    .anchor-list a[href="#appendix"] { --nav-accent: var(--accent-review); }

    .anchor-list a::after {
      position: absolute;
      right: 12px;
      bottom: 0;
      left: 12px;
      height: 2px;
      background: transparent;
      content: "";
    }

    .anchor-list a[data-active="true"] {
      color: var(--nav-accent);
      font-weight: 780;
    }

    .anchor-list a[data-active="true"]::after { background: var(--nav-accent); }

    .originals-menu { position: relative; flex: 0 0 auto; }

    .originals-menu summary {
      min-height: 38px;
      padding: 8px 10px;
      border: 1px solid #97a4a5;
      border-radius: 3px;
      color: var(--ink);
      cursor: pointer;
      font-size: 12px;
      font-weight: 720;
      list-style: none;
    }

    .originals-menu summary::-webkit-details-marker { display: none; }

    .originals-menu summary::after { padding-left: 7px; content: "+"; }
    .originals-menu[open] summary::after { content: "-"; }
    .originals-menu summary:hover { border-color: var(--accent-architecture); background: var(--accent-architecture-soft); }

    .originals-list {
      position: absolute;
      z-index: 31;
      top: calc(100% + 7px);
      right: 0;
      width: 360px;
      max-height: min(62vh, 580px);
      margin: 0;
      padding: 6px 0;
      overflow: auto;
      border: 1px solid var(--rule-strong);
      border-radius: 3px;
      background: var(--paper);
      box-shadow: 0 12px 26px rgb(73 61 43 / .14);
      list-style: none;
    }

    .originals-list a {
      display: grid;
      gap: 2px;
      padding: 9px 12px;
      color: var(--ink);
      font-size: 13px;
      line-height: 1.4;
      overflow-wrap: anywhere;
      text-decoration: none;
    }

    .originals-list a:hover { background: var(--blue-soft); }
    .originals-list span { color: var(--blue); font-size: 11px; font-weight: 740; }

    main {
      display: grid;
      grid-template-columns: 202px minmax(0, 1fr);
      gap: 42px;
      width: min(var(--content-width), calc(100% - 64px));
      margin: 0 auto;
      padding-bottom: 104px;
    }

    .section-rail {
      position: sticky;
      top: calc(var(--nav-height) + 30px);
      align-self: start;
      min-height: 0;
      margin-top: 64px;
      padding: 0 18px 0 0;
      border-right: 1px solid var(--rule);
    }

    .rail-label {
      margin: 0 0 13px;
      color: var(--accent-review-ink);
      font-family: var(--code-font);
      font-size: 11px;
      font-weight: 780;
      line-height: 1.3;
    }

    .rail-panels {
      max-height: calc(100vh - var(--nav-height) - 104px);
      padding-right: 8px;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
    }

    .rail-panel[hidden] { display: none; }

    .rail-panel {
      --rail-accent: var(--accent-review);
      --rail-accent-soft: var(--band-review);
      --rail-accent-ink: var(--accent-review-ink);
      min-width: 0;
    }
    .rail-panel[data-rail-panel="prd"],
    .rail-panel[data-rail-panel="business-flow"] {
      --rail-accent: var(--accent-business);
      --rail-accent-soft: var(--band-business);
      --rail-accent-ink: var(--accent-business-ink);
    }
    .rail-panel[data-rail-panel="esp"],
    .rail-panel[data-rail-panel="architecture-flow"] {
      --rail-accent: var(--accent-architecture);
      --rail-accent-soft: var(--band-architecture);
      --rail-accent-ink: var(--accent-architecture-ink);
    }
    .rail-panel[data-rail-panel="action-cards"],
    .rail-panel[data-rail-panel="appendix"] {
      --rail-accent: var(--accent-review);
      --rail-accent-soft: var(--band-review);
      --rail-accent-ink: var(--accent-review-ink);
    }

    .rail-article-title {
      margin: 0 0 10px;
      padding: 8px 10px;
      border-left: 3px solid var(--rail-accent);
      background: var(--rail-accent-soft);
      color: var(--rail-accent-ink);
      font-size: 13px;
      font-weight: 770;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .rail-list {
      counter-reset: dossier-outline;
      display: grid;
      gap: 3px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .rail-list li {
      --rail-indent: 0px;
      counter-increment: dossier-outline;
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr);
      align-items: start;
      padding-left: 0;
    }

    .rail-list li::before {
      grid-column: 1;
      padding-top: 9px;
      color: var(--faint);
      content: counter(dossier-outline, decimal-leading-zero);
      font-family: var(--code-font);
      font-size: 10px;
      line-height: 1;
    }

    .rail-list .rail-empty {
      counter-increment: none;
      grid-column: 1 / -1;
      padding-left: 0;
      color: var(--faint);
      font-size: 12px;
      line-height: 1.5;
    }

    .rail-list .rail-empty::before { content: none; }
    .rail-list .rail-depth-1 { --rail-indent: 8px; }
    .rail-list .rail-depth-2 { --rail-indent: 16px; }
    .rail-list .rail-depth-3 { --rail-indent: 24px; }

    .rail-list a {
      grid-column: 2;
      min-width: 0;
      padding: 6px 0 6px calc(var(--rail-indent) + 6px);
      color: var(--muted);
      font-size: 12px;
      font-weight: 650;
      line-height: 1.4;
      overflow-wrap: anywhere;
      text-decoration: none;
    }

    .rail-list .rail-depth-1 a { font-size: 11.5px; }
    .rail-list .rail-depth-2 a,
    .rail-list .rail-depth-3 a { font-size: 11px; }

    .rail-list a[data-active="true"] {
      margin-left: 0;
      padding-left: calc(var(--rail-indent) + 6px);
      box-shadow: inset 2px 0 var(--rail-accent);
      color: var(--rail-accent);
      font-weight: 780;
    }

    .rail-panel[data-rail-panel="prd"] .rail-list li,
    .rail-panel[data-rail-panel="esp"] .rail-list li,
    .rail-panel[data-rail-panel="appendix"] .rail-list li {
      grid-template-columns: minmax(0, 1fr);
    }

    .rail-panel[data-rail-panel="prd"] .rail-list li::before,
    .rail-panel[data-rail-panel="esp"] .rail-list li::before,
    .rail-panel[data-rail-panel="appendix"] .rail-list li::before {
      content: none;
    }

    .rail-panel[data-rail-panel="prd"] .rail-list a,
    .rail-panel[data-rail-panel="esp"] .rail-list a,
    .rail-panel[data-rail-panel="appendix"] .rail-list a {
      grid-column: 1;
      display: grid;
      grid-template-columns: 3.2em minmax(0, 1fr);
      gap: 4px;
      padding-left: calc(var(--rail-indent) + 8px);
    }

    .rail-panel[data-rail-panel="action-cards"] .rail-list a {
      padding-left: 8px;
    }

    .rail-heading-number {
      color: var(--faint);
      font-family: var(--code-font);
      font-size: .88em;
      font-weight: 560;
      text-align: left;
    }

    .rail-heading-label { min-width: 0; }
    .rail-heading-label-full { grid-column: 1 / -1; }

    .rail-appendix-groups { display: grid; gap: 8px; }

    .rail-appendix-group {
      border: 1px solid var(--rule);
      border-radius: 3px;
      background: var(--paper);
    }

    .rail-appendix-group summary {
      display: flex;
      gap: 8px;
      align-items: center;
      padding: 8px 9px;
      color: var(--muted);
      cursor: pointer;
      font-size: 12px;
      font-weight: 720;
      line-height: 1.35;
      list-style: none;
    }

    .rail-appendix-group summary::-webkit-details-marker { display: none; }
    .rail-appendix-group summary::before { content: "+"; color: var(--rail-accent); }
    .rail-appendix-group[open] summary::before { content: "-"; }
    .rail-appendix-group summary span { margin-left: auto; color: var(--faint); font-size: 10px; font-weight: 560; }
    .rail-appendix-group .rail-list { padding: 4px 4px 9px; border-top: 1px solid var(--rule); }

    .dossier-content { min-width: 0; }

    .chapter {
      --chapter-accent: var(--accent-review);
      --chapter-accent-soft: var(--accent-review-soft);
      --chapter-accent-ink: var(--accent-review-ink);
      --chapter-band: var(--band-review);
      scroll-margin-top: calc(var(--nav-height) + 22px);
    }

    #prd,
    #business-flow {
      --chapter-accent: var(--accent-business);
      --chapter-accent-soft: var(--accent-business-soft);
      --chapter-accent-ink: var(--accent-business-ink);
      --chapter-band: var(--band-business);
    }

    #esp,
    #architecture-flow {
      --chapter-accent: var(--accent-architecture);
      --chapter-accent-soft: var(--accent-architecture-soft);
      --chapter-accent-ink: var(--accent-architecture-ink);
      --chapter-band: var(--band-architecture);
    }

    #action-cards,
    #appendix {
      --chapter-accent: var(--accent-review);
      --chapter-accent-soft: var(--accent-review-soft);
      --chapter-accent-ink: var(--accent-review-ink);
      --chapter-band: var(--band-review);
    }

    .document-content h2,
    .document-content h3,
    .document-content h4,
    .document-content h5,
    .document-content h6,
    .action-card,
    figcaption { scroll-margin-top: calc(var(--nav-height) + 22px); }

    .chapter {
      padding: 64px 0 72px;
      border-bottom: 1px solid var(--rule);
    }

    .chapter-heading {
      max-width: 900px;
      padding: 18px 20px 19px;
      border-left: 5px solid var(--chapter-accent);
      background: var(--chapter-band);
    }

    .chapter-heading h2 {
      margin: 8px 0 0;
      color: var(--ink);
      font-family: var(--display-font);
      font-size: 32px;
      line-height: 1.22;
      font-weight: 800;
    }

    .chapter-source {
      display: flex;
      flex-wrap: wrap;
      gap: 7px 13px;
      max-width: var(--reading-width);
      margin: 15px 0 0;
      color: var(--faint);
      font-family: var(--code-font);
      font-size: 11px;
      line-height: 1.55;
    }

    .chapter > .chapter-source {
      max-width: 900px;
      margin-top: 0;
      padding: 10px 20px 11px;
      border-bottom: 1px solid var(--chapter-accent);
      background: var(--paper);
    }

    .chapter-source span { color: var(--chapter-accent); font-weight: 700; }
    .chapter-source a { color: var(--blue); }

    .document-content,
    .action-card-content { max-width: var(--reading-width); }

    .document-content > :first-child,
    .action-card-content > :first-child { margin-top: 30px; }

    .document-content h2,
    .document-content h3,
    .document-content h4,
    .document-content h5,
    .document-content h6,
    .action-card-content h3,
    .action-card-content h4,
    .action-card-content h5,
    .action-card-content h6 {
      margin: 42px 0 13px;
      color: var(--ink);
      font-family: var(--display-font);
      line-height: 1.3;
      font-weight: 750;
    }

    .document-content h2 { font-size: 25px; }
    .document-content h3 { font-size: 21px; }
    .document-content h4,
    .action-card-content h4 { font-size: 17px; }
    .action-card-content h3 { font-size: 19px; }

    .chapter-document .document-content h3 {
      padding-left: 12px;
      border-left: 3px solid var(--chapter-accent);
    }

    .document-content p,
    .action-card-content p,
    .document-content li,
    .action-card-content li { overflow-wrap: anywhere; }

    .document-content blockquote,
    .action-card-content blockquote {
      margin: 25px 0;
      padding: 8px 0 8px 20px;
      border-left: 4px solid var(--chapter-accent);
      background: transparent;
      color: #494239;
    }

    .document-content code,
    .action-card-content code,
    .figure-source code {
      padding: 1px 4px;
      border-radius: 2px;
      background: #f0ece2;
      color: #28495d;
      font-family: var(--code-font);
      font-size: .88em;
      overflow-wrap: anywhere;
    }

    .code-block {
      margin: 22px 0;
      border: 1px solid #443e36;
      border-radius: 3px;
      background: #2b2823;
      color: #f2ede2;
      overflow: hidden;
    }

    .code-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      min-height: 39px;
      padding: 0 11px;
      border-bottom: 1px solid #665d50;
      color: #e5ddcf;
      font-family: var(--code-font);
      font-size: 12px;
    }

    .code-copy {
      min-height: 28px;
      padding: 3px 8px;
      border: 1px solid #a99b84;
      border-radius: 2px;
      background: transparent;
      color: #edf5f2;
      cursor: pointer;
      font: inherit;
    }

    .code-block pre {
      margin: 0;
      padding: 15px;
      overflow: auto;
      color: inherit;
      font-family: var(--code-font);
      font-size: 13px;
      line-height: 1.55;
    }

    .document-content pre,
    .action-card-content pre {
      max-width: 100%;
      overflow: auto;
    }

    .table-scroll {
      max-width: 100%;
      margin: 22px 0;
      overflow: auto;
      border: 1px solid var(--rule-strong);
      border-radius: 2px;
      background: var(--paper);
    }

    table { width: 100%; min-width: 560px; border-collapse: collapse; }
    th, td { padding: 10px 12px; border: 1px solid var(--rule); text-align: start; vertical-align: top; overflow-wrap: anywhere; }
    th { background: #f0ebe0; color: var(--ink); font-weight: 760; }
    .chapter-document .document-content th { background: var(--chapter-band); }

    .document-content img,
    .action-card-content img { max-width: 100%; height: auto; }

    .chapter-figure { max-width: none; min-width: 0; }

    .map-figure {
      min-width: 0;
      margin: 30px 0 0;
      padding: 16px 16px 0;
      border: 1px solid var(--rule-strong);
      border-top: 3px solid var(--chapter-accent);
      background: #f1ebdf;
    }

    .map-stage {
      min-width: 0;
      width: 100%;
      overflow: auto;
      border: 1px solid #8e8a7c;
      border-radius: 0;
      background: var(--paper);
    }

    .map-stage svg { display: block; width: 100%; min-width: 1040px; height: auto; }

    figcaption {
      display: grid;
      gap: 8px;
      max-width: none;
      margin-top: 0;
      padding: 15px 4px 17px;
      border-top: 1px solid var(--rule-strong);
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }

    figcaption p { margin: 0; }

    .figure-source { display: flex; flex-wrap: wrap; gap: 6px; color: var(--faint); font-family: var(--code-font); font-size: 11px; }
    .figure-source span { color: var(--chapter-accent); }
    .figure-links { display: flex; flex-wrap: wrap; gap: 15px; font-size: 12px; }

    .chapter-review-maps {
      --diagram-page: #f2eee7;
      --diagram-surface: #fffdf8;
      --diagram-surface-alt: #f3eee5;
      --diagram-ink: #2d2924;
      --diagram-ink-2: #5d554c;
      --diagram-ink-3: #82776a;
      --diagram-line: #ddd3c5;
      --diagram-line-strong: #bcae9c;
      --diagram-business: var(--accent-business);
      --diagram-business-soft: var(--accent-business-soft);
      --diagram-architecture: var(--accent-architecture);
      --diagram-architecture-soft: var(--accent-architecture-soft);
      --diagram-signal: var(--accent-signal);
      --diagram-signal-soft: var(--accent-signal-soft);
      --diagram-review: var(--accent-review);
      --diagram-review-soft: var(--accent-review-soft);
    }

    .review-map-collection { margin-top: 28px; }

    .review-map-section {
      --diagram-accent: var(--diagram-business);
      --diagram-accent-soft: var(--diagram-business-soft);
      --diagram-accent-ink: var(--accent-business-ink);
      min-width: 0;
      padding: 12px 0 52px;
      scroll-margin-top: calc(var(--nav-height) + 12px);
    }

    .review-map-section[id$="-technical-architecture"],
