      color: var(--diagram-ink-3);
      font-family: var(--code-font);
      font-size: 8px;
      font-weight: 800;
    }

    .responsibility-mark.primary { border-color: var(--diagram-business); background: var(--diagram-business); color: #fff; }
    .responsibility-mark.support { border-color: var(--diagram-business); color: var(--diagram-business); }
    .responsibility-mark.review { border-color: var(--diagram-review); border-style: dashed; color: var(--diagram-review); }
    .business-table tbody td .responsibility-mark.primary { border-color: var(--role-accent); background: var(--role-accent); }
    .business-table tbody td .responsibility-mark.support { border-color: var(--role-accent); color: var(--role-accent); }
    .business-table tbody td .responsibility-mark.review { border-color: var(--diagram-review); color: var(--diagram-review); }

    .feature-list { display: flex; flex-wrap: wrap; gap: 5px; margin: 0; padding: 0; list-style: none; }
    .feature-list li {
      padding: 4px 7px;
      border: 1px solid var(--diagram-line);
      border-left: 3px solid var(--row-accent);
      border-radius: 2px;
      background: var(--diagram-surface);
      color: var(--diagram-ink-2);
      font-size: 9px;
      font-weight: 650;
    }

    .business-landscape [data-role-filter="all"][aria-pressed="true"] { background: var(--diagram-ink); }
    .business-landscape [data-role-filter="marketing"][aria-pressed="true"] { background: var(--diagram-business); }
    .business-landscape [data-role-filter="content"][aria-pressed="true"] { background: var(--diagram-signal); }
    .business-landscape [data-role-filter="owner"][aria-pressed="true"] { background: var(--diagram-architecture); }
    .business-landscape [data-role-filter="governance"][aria-pressed="true"] { background: var(--diagram-review); }

    .scenario-stack,
    .sequence-stack { padding: 16px; }
    .review-tab-panel { margin: 0; }
    .review-tab-panel + .review-tab-panel { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--diagram-line); }
    html.diagram-enhanced .review-tab-panel:not(.is-active) { display: none; }
    html.diagram-enhanced .review-tab-panel + .review-tab-panel { margin-top: 0; padding-top: 0; border-top: 0; }

    .scenario-panel-heading,
    .sequence-panel-heading { display: flex; justify-content: space-between; gap: 20px; align-items: baseline; margin-bottom: 12px; }
    .scenario-panel-heading h4,
    .sequence-panel-heading h4 { margin: 0; color: var(--diagram-ink); font-size: 15px; }
    .scenario-panel-heading p,
    .sequence-panel-heading p { max-width: 70ch; margin: 0; color: var(--diagram-ink-3); font-size: 10px; }

    .scenario-flow-index {
      display: grid;
      grid-template-columns: 164px repeat(var(--scenario-columns), minmax(142px, 1fr));
      min-width: calc(164px + var(--scenario-columns) * 142px);
      padding: 6px 0 8px;
      color: var(--diagram-ink-3);
      font-family: var(--code-font);
      font-size: 8px;
    }

    .scenario-flow-index::before { content: "时间顺序 ->"; align-self: center; padding-left: 10px; }
    .scenario-flow-index span { display: grid; justify-items: center; gap: 2px; position: relative; text-align: center; }
    .scenario-flow-index span:not(:last-child)::after {
      position: absolute;
      top: 7px;
      left: 56%;
      width: 88%;
      border-top: 1px solid var(--diagram-line-strong);
      content: "";
    }
    .scenario-flow-index b { z-index: 1; padding: 1px 5px; background: var(--diagram-surface); color: var(--diagram-signal); font-size: 9px; }
    .scenario-flow-index small { max-width: 13ch; font-size: 7.5px; white-space: normal; }

    .scenario-panel { max-width: 100%; overflow: auto; }
    .scenario-lanes { min-width: max-content; border: 1px solid var(--diagram-line); }
    .scenario-lane { display: grid; grid-template-columns: 164px minmax(0, 1fr); min-height: 108px; border-bottom: 1px solid var(--diagram-line); }
    .scenario-lane:last-child { border-bottom: 0; }
    .scenario-lane:nth-child(odd) { background: #faf7f2; }
    .scenario-lane-label { display: grid; align-content: center; padding: 12px; border-right: 1px solid var(--diagram-line); }
    .scenario-lane-label strong { font-size: 11px; }
    .scenario-lane-label span { margin-top: 3px; color: var(--diagram-ink-3); font-size: 8px; }
    .scenario-timeline {
      display: grid;
      grid-template-columns: repeat(var(--scenario-columns), minmax(142px, 1fr));
      gap: 8px;
      align-items: center;
      min-width: calc(var(--scenario-columns) * 142px);
      padding: 12px 8px;
    }

    .scenario-step {
      display: grid;
      min-height: 72px;
      align-content: center;
      padding: 9px 9px 8px;
      border: 1px solid var(--diagram-business);
      border-radius: 5px;
      background: var(--diagram-business-soft);
    }
    .scenario-step > span { color: var(--diagram-business); font-family: var(--code-font); font-size: 8px; font-weight: 800; }
    .scenario-step strong { margin-top: 3px; font-size: 10px; }
    .scenario-step small { margin-top: 2px; color: var(--diagram-ink-2); font-size: 8px; }
    .scenario-step.tone-architecture { border-color: var(--diagram-architecture); background: var(--diagram-architecture-soft); }
    .scenario-step.tone-signal { border-color: var(--diagram-signal); background: var(--diagram-signal-soft); }
    .scenario-step.tone-review { border-color: var(--diagram-review); border-style: dashed; background: var(--diagram-review-soft); }

    .scenario-context,
    .object-chain { display: flex; gap: 12px; align-items: center; min-width: max-content; padding: 10px 12px; border: 1px solid var(--diagram-line); border-top: 0; }
    .scenario-context { background: var(--diagram-review-soft); }
    .scenario-context strong,
    .object-chain > span { flex: 0 0 auto; color: var(--diagram-ink); font-size: 9px; }
    .scenario-context ul,
    .object-chain ol { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 0; padding: 0; list-style: none; }
    .scenario-context li { color: var(--diagram-ink-2); font-size: 8px; }
    .object-chain li { position: relative; color: var(--diagram-architecture); font-family: var(--code-font); font-size: 8px; font-weight: 700; }
    .object-chain li:not(:last-child)::after { position: absolute; left: calc(100% + 6px); content: "->"; color: var(--diagram-ink-3); }
    .scenario-panel figcaption,
    .sequence-panel figcaption { margin: 0; padding: 10px 2px 0; border: 0; color: var(--diagram-ink-2); font-size: 10px; }

    .architecture-canvas { padding: 16px; }
    .external-nodes { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; margin: 0 190px 12px 0; }
    .architecture-grid { display: grid; grid-template-columns: minmax(0, 1fr) 176px; gap: 12px; }
    .system-boundary { position: relative; padding: 30px 12px 12px; border: 1px solid var(--diagram-architecture); border-radius: 4px; }
    .system-label { position: absolute; top: 0; left: 0; padding: 5px 9px; background: var(--diagram-architecture); color: #fff; font-family: var(--code-font); font-size: 8px; font-weight: 720; }
    .architecture-layer { display: grid; grid-template-columns: 112px minmax(0, 1fr); min-height: 76px; border-bottom: 1px solid var(--diagram-line); }
    .architecture-layer:last-child { border-bottom: 0; }
    .architecture-layer-name { display: grid; align-content: center; padding: 10px; border-right: 1px solid var(--diagram-line); }
    .architecture-layer-name strong { font-size: 10px; }
    .architecture-layer-name span { margin-top: 3px; color: var(--diagram-ink-3); font-family: var(--code-font); font-size: 7px; }
    .architecture-layer-nodes { display: grid; grid-template-columns: repeat(auto-fit, minmax(105px, 1fr)); gap: 7px; align-items: center; padding: 9px 0 9px 9px; }
    .architecture-node {
      position: relative;
      display: grid;
      min-height: 48px;
      align-content: center;
      padding: 7px;
      border: 1px solid var(--diagram-line);
      border-radius: 3px;
      background: var(--diagram-surface);
      color: var(--diagram-ink);
      text-align: left;
      transition: opacity 180ms ease, border-color 180ms ease, background-color 180ms ease;
    }
    button.architecture-node { cursor: pointer; font: inherit; }
    button.architecture-node:hover { border-color: var(--diagram-architecture); background: var(--diagram-architecture-soft); }
    .architecture-node strong { font-size: 9px; line-height: 1.25; }
    .architecture-node > span { margin-top: 2px; color: var(--diagram-ink-3); font-family: var(--code-font); font-size: 7px; }
    .architecture-node em { margin-top: 4px; color: var(--diagram-review); font-family: var(--code-font); font-size: 6.5px; font-style: normal; font-weight: 700; }
    .architecture-node.state-domain { border-color: #8bb7ca; background: var(--diagram-architecture-soft); }
    .architecture-node.state-review-bound { border-color: var(--diagram-review); border-style: dashed; background: var(--diagram-review-soft); }
    [data-architecture-canvas].has-focus .architecture-layer:not(.is-focus) { opacity: .22; }
    [data-architecture-canvas].has-focus .architecture-layer.is-focus { background: #fffaf4; }
    [data-architecture-canvas].has-focus .architecture-layer.is-focus .architecture-node { border-color: var(--diagram-signal); }
    .crosscutting { display: grid; align-content: start; gap: 7px; padding: 11px; border: 1px solid var(--diagram-line-strong); border-radius: 4px; background: #faf7f1; }
    .crosscutting h4 { margin: 0 0 2px; font-size: 10px; }
    .crosscut-item { display: grid; padding: 7px; border-left: 3px solid var(--diagram-signal); background: var(--diagram-signal-soft); }
    .crosscut-item strong { font-size: 8.5px; }
    .crosscut-item span { color: var(--diagram-ink-3); font-size: 7px; }

    .module-topology { position: relative; display: grid; grid-template-columns: repeat(auto-fit, minmax(148px, 1fr)); gap: 10px; padding: 16px; border-bottom: 1px solid var(--diagram-line); }
    .module-button {
      min-height: 88px;
      padding: 11px;
      border: 1px solid var(--diagram-line-strong);
      border-radius: 4px;
      background: var(--diagram-surface);
      color: var(--diagram-ink);
      cursor: pointer;
      font: inherit;
      text-align: left;
      transition: transform 180ms ease, border-color 180ms ease, background-color 180ms ease;
    }
    .module-button:hover { transform: translateY(-2px); border-color: var(--diagram-architecture); }
    .module-button[aria-selected="true"] { border-color: var(--diagram-architecture); background: var(--diagram-architecture-soft); }
    .module-button > span { display: block; color: var(--diagram-architecture); font-family: var(--code-font); font-size: 7px; font-weight: 740; }
    .module-button strong { display: block; margin-top: 4px; font-size: 10px; }
    .module-button small { display: block; margin-top: 5px; color: var(--diagram-ink-3); font-size: 8px; }
    .module-crosscutting { display: flex; flex-wrap: wrap; gap: 8px; padding: 10px 16px; border-bottom: 1px solid var(--diagram-line); }
    .module-crosscutting span { padding: 5px 8px; border-left: 3px solid var(--diagram-signal); background: var(--diagram-signal-soft); color: var(--diagram-ink-2); font-size: 8px; }
    .module-details { padding: 0 16px 16px; }
    .module-detail { padding-top: 16px; }
    .module-detail > header { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 20px; align-items: start; margin-bottom: 10px; }
    .module-detail h4 { margin: 0; font-size: 16px; }
    .module-detail header p { max-width: 76ch; margin: 3px 0 0; color: var(--diagram-ink-2); font-size: 9px; }
    .module-namespace { padding: 4px 7px; border: 1px solid var(--diagram-line); border-radius: 3px; color: var(--diagram-architecture); font-size: 8px; }
    .service-table-wrap { max-width: 100%; overflow: auto; }
    .service-table { width: 100%; min-width: 720px; table-layout: fixed; border-collapse: collapse; }
    .service-table th,
    .service-table td { padding: 9px; border: 0; border-top: 1px solid var(--diagram-line); background: transparent; vertical-align: top; text-align: left; }
    .service-table th { width: 34%; padding-left: 0; }
    .service-table td { padding-right: 0; }
    .service-table th code { display: block; padding: 0; background: transparent; color: var(--diagram-ink); font-size: 8.5px; overflow-wrap: anywhere; }
    .service-table th > span { display: block; margin-top: 4px; color: var(--diagram-ink-3); font-size: 8px; font-weight: 400; }
    .service-operations { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; }
    .service-operation { min-width: 0; padding: 7px 8px; border-left: 2px solid var(--diagram-architecture); background: #f8f4ee; }
    .service-operation header { display: flex; gap: 6px; align-items: center; }
    .service-operation code { padding: 0; background: transparent; color: var(--diagram-ink); font-size: 8px; overflow-wrap: anywhere; }
    .service-operation p { margin: 5px 0 0; color: var(--diagram-ink-2); font-size: 8px; }
    .service-operation > span { display: block; margin-top: 3px; color: var(--diagram-ink-3); font-family: var(--code-font); font-size: 7px; }
    .module-contract-note { margin: 10px 0 0; padding: 8px 10px; border-left: 3px solid var(--diagram-review); background: var(--diagram-review-soft); color: var(--diagram-ink-2); font-size: 8px; }
    .operation-kind { display: inline-grid; width: 18px; height: 18px; place-items: center; margin-right: 7px; border: 1px solid var(--diagram-architecture); border-radius: 2px; color: var(--diagram-architecture); font-family: var(--code-font); font-size: 7px; }
    .operation-kind.kind-c { border-color: var(--diagram-business); color: var(--diagram-business); }
    .operation-kind.kind-e { border-color: var(--diagram-signal); color: var(--diagram-signal); }

    .sequence-scroll { max-width: 100%; overflow: auto; }
    .sequence-chart { min-width: calc(92px + var(--participant-count) * 150px); border: 1px solid var(--diagram-line); }
    .sequence-participants,
    .sequence-message-row { display: grid; grid-template-columns: 64px repeat(var(--participant-count), minmax(150px, 1fr)); }
    .sequence-participants { min-height: 64px; border-bottom: 1px solid var(--diagram-line-strong); background: #faf7f1; }
    .sequence-participants > span { display: grid; place-items: center; color: var(--diagram-ink-3); font-family: var(--code-font); font-size: 8px; }
    .sequence-participants > div { display: grid; align-content: center; justify-items: center; padding: 8px; border-left: 1px solid var(--diagram-line); text-align: center; }
    .sequence-participants strong { font-size: 9px; }
    .sequence-participants span { margin-top: 2px; color: var(--diagram-ink-3); font-size: 7px; }
    .sequence-body { position: relative; background: repeating-linear-gradient(90deg, transparent 0, transparent calc((100% - 64px) / var(--participant-count) - 1px), rgb(221 211 197 / .45) calc((100% - 64px) / var(--participant-count))); }
    .sequence-message-row { position: relative; min-height: 72px; border-bottom: 1px solid var(--diagram-line); }
    .sequence-message-row:last-child { border-bottom: 0; }
    .sequence-index { grid-column: 1; display: grid; place-items: center; color: var(--diagram-ink-3); font-family: var(--code-font); font-size: 8px; }
    .sequence-message { position: relative; grid-column: var(--sequence-start) / var(--sequence-end); display: grid; align-content: center; min-width: 0; padding: 8px 24px; text-align: center; }
    .sequence-message::before { position: absolute; top: 50%; right: 8px; left: 8px; border-top: 2px solid var(--diagram-architecture); content: ""; }
    .sequence-message::after { position: absolute; top: calc(50% - 4px); right: 7px; width: 7px; height: 7px; border-top: 2px solid var(--diagram-architecture); border-right: 2px solid var(--diagram-architecture); content: ""; transform: rotate(45deg); }
    .sequence-message.reverse::after { right: auto; left: 7px; border: 0; border-bottom: 2px solid var(--diagram-architecture); border-left: 2px solid var(--diagram-architecture); }
    .sequence-message.kind-async::before { border-color: var(--diagram-signal); border-top-style: dashed; }
    .sequence-message.kind-async::after { border-color: var(--diagram-signal); }
    .sequence-message.kind-return::before { border-color: var(--diagram-ink-3); border-top-style: dotted; }
    .sequence-message.kind-return::after { border-color: var(--diagram-ink-3); }
    .sequence-message.self::before { border-radius: 5px; border-right: 2px solid var(--diagram-architecture); }
    .sequence-message strong,
    .sequence-message small,
    .sequence-route { position: relative; z-index: 1; width: max-content; max-width: 100%; margin-inline: auto; padding-inline: 4px; background: var(--diagram-surface); }
    .sequence-message strong { font-size: 9px; }
    .sequence-message small { color: var(--diagram-ink-3); font-size: 7.5px; }
    .sequence-route { color: var(--diagram-architecture); font-family: var(--code-font); font-size: 6.5px; }

    .chapter-intro {
      max-width: var(--reading-width);
      margin: 17px 0 28px;
      color: var(--muted);
    }

    .chapter-heading + .chapter-intro {
      max-width: 900px;
      margin: 0 0 28px;
      padding: 11px 20px 12px;
      border-bottom: 1px solid var(--chapter-accent);
      background: var(--paper);
    }

    .action-card-group {
      display: grid;
      gap: 0;
      max-width: 980px;
      margin-top: 24px;
      border-top: 2px solid var(--chapter-accent);
    }

    .action-card {
      position: relative;
      padding: 30px 0 36px;
      border: 0;
      border-bottom: 1px solid var(--rule);
      border-radius: 0;
      background: transparent;
    }

    .action-card::before {
      position: absolute;
      top: 0;
      left: 0;
      width: 32px;
      height: 3px;
      background: var(--chapter-accent);
      content: "";
    }

    .action-card-id {
      margin: 0;
      color: var(--chapter-accent);
      font-family: var(--code-font);
      font-size: 12px;
      font-weight: 760;
    }

    .action-card .chapter-source { margin-top: 10px; }
    .action-card-content > :first-child { margin-top: 20px; }

    .chapter-appendix { min-height: calc(100vh - var(--nav-height)); }
    .chapter-appendix > .chapter-intro { margin-bottom: 0; }

    .appendix-document-groups {
      display: grid;
      gap: 12px;
      max-width: 980px;
      margin-top: 28px;
    }

    .appendix-document-group {
      border: 1px solid var(--rule-strong);
      border-radius: 3px;
      background: var(--paper);
    }

    .appendix-document-group > summary {
      display: flex;
      gap: 20px;
      align-items: center;
      padding: 15px 18px;
      color: var(--ink);
      cursor: pointer;
      list-style: none;
    }

    .appendix-document-group > summary::-webkit-details-marker { display: none; }
    .appendix-document-group > summary::before { content: "+"; color: var(--chapter-accent); font-family: var(--code-font); }
    .appendix-document-group[open] > summary::before { content: "-"; }
    .appendix-document-group > summary strong { margin-right: auto; font-size: 16px; }
    .appendix-document-group > summary span { color: var(--faint); font-size: 12px; }
    .appendix-group-body { padding: 0 18px; border-top: 1px solid var(--rule); }

    .appendix-source {
      max-width: 980px;
      padding: 34px 0 42px;
      border-bottom: 1px solid var(--rule);
    }

    .appendix-origin {
      margin: 0;
      color: var(--chapter-accent);
      font-family: var(--code-font);
      font-size: 12px;
      font-weight: 760;
    }

    .appendix-source .chapter-source { margin-top: 10px; }
    .appendix-source .document-content > :first-child { margin-top: 24px; }

    .motion-status {
      position: fixed;
      z-index: 39;
      right: 20px;
      bottom: 20px;
      max-width: 480px;
      margin: 0;
      padding: 10px 13px;
      border: 1px solid #b17a26;
      border-radius: 3px;
      background: #fff7e7;
      color: #6f470d;
      font-size: 13px;
      line-height: 1.45;
      box-shadow: 0 8px 20px rgb(73 61 43 / .13);
    }

    @media (max-width: 1120px) {
      main { grid-template-columns: 172px minmax(0, 1fr); gap: 28px; }
      .section-rail { padding-right: 13px; }
      .chapter-heading h2 { font-size: 29px; }
      .anchor-list a { padding-inline: 10px; }
      .anchor-list a::after { right: 10px; left: 10px; }
      .review-map-heading { grid-template-columns: 48px minmax(0, 1fr); }
      .review-map-tag { grid-column: 2; justify-self: start; }
      .architecture-grid { grid-template-columns: minmax(0, 1fr) 150px; }
      .external-nodes { margin-right: 162px; }
    }

    @media (prefers-reduced-motion: no-preference) {
      .anchor-list a,
      .originals-list a,
      .code-copy,
      .segmented button,
      .diagram-reset {
        transition: color 180ms ease, background-color 180ms ease, border-color 180ms ease;
      }

      html.motion-ready [data-reveal][data-reveal-state="pending"] {
        opacity: 0;
        transform: translateY(14px);
      }

      html.motion-ready [data-reveal][data-reveal-state="visible"] {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 440ms ease-out var(--reveal-delay, 0ms), transform 440ms ease-out var(--reveal-delay, 0ms);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
      }
    }

    @media print {
      .reading-position,
      .skip-link,
      .anchor-shell,
      .section-rail,
      .motion-status,
      .segmented,
      .diagram-reset { display: none !important; }

      .masthead { border-bottom: 0; }
      .chapter { break-inside: avoid-page; }
      body { background: var(--paper); }
      .review-tab-panel { display: block !important; }
    }
  </style>
</head>
<body data-wff-human-review-dossier data-role="continuous-human-review">
  <a class="skip-link" href="#dossier-main">跳到 dossier 正文</a>
  <div class="reading-position" id="reading-position" aria-hidden="true"></div>

  <header class="masthead">
    <div class="masthead-inner">
      <p class="masthead-label">WFF / HUMAN REVIEW DOSSIER</p>
      <p class="case-name">@@WFF_CASE_NAME@@ · @@WFF_SECTION_COUNT@@ 个章节 · @@WFF_ACTION_CARD_COUNT@@ 张卡片</p>
    </div>
  </header>

  <nav class="anchor-shell" aria-label="dossier 章节导航">
    <div class="anchor-inner">
      <div class="anchor-scroll"><ol class="anchor-list">@@WFF_ANCHOR_NAVIGATION@@</ol></div>
      <details class="originals-menu">
        <summary>原件</summary>
        <ul class="originals-list">@@WFF_ORIGINAL_LINKS@@</ul>
      </details>
    </div>
  </nav>

  <main id="dossier-main" tabindex="-1">
    <aside class="section-rail" aria-label="当前文章目录">
      <p class="rail-label">当前文章目录</p>
      <div class="rail-panels">@@WFF_RAIL_PANELS@@</div>
    </aside>
    <div class="dossier-content">
      @@WFF_DOSSIER_SECTIONS@@
    </div>
  </main>

  <p class="motion-status" id="motion-status" hidden role="status"></p>

  <script>
    "use strict";
    (() => {
      const root = document.documentElement;
      const revealUnits = Array.from(document.querySelectorAll("[data-reveal]"));
      const motionStatus = document.getElementById("motion-status");
      let motionFailed = false;

      function revealAll() {
        revealUnits.forEach((unit) => {
          unit.dataset.revealState = "visible";
          unit.style.removeProperty("--reveal-delay");
        });
      }

      function failMotion() {
        if (motionFailed) return;
        motionFailed = true;
        root.classList.remove("motion-ready");
        root.classList.remove("diagram-enhanced");
        revealAll();
        if (motionStatus) {
          motionStatus.hidden = false;
          motionStatus.textContent = "阅读定位动画未启动；正文与图形仍可直接阅读。";
        }
      }

      function guard(callback) {
        return (...args) => {
          try {
            callback(...args);
          } catch (_error) {
            failMotion();
          }
        };
      }

      try {
        if (new URLSearchParams(window.location.search).has("wff-force-motion-failure")) {
          throw new Error("motion failure fixture");
        }

        const reducedMotion = Boolean(
          window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches
        );
        const readingPosition = document.getElementById("reading-position");
        const sections = Array.from(document.querySelectorAll("[data-section]"));
        const anchorLinks = Array.from(document.querySelectorAll("[data-anchor-link]"));
        const outlineLinks = Array.from(document.querySelectorAll("[data-outline-link]"));
        const railPanels = Array.from(document.querySelectorAll("[data-rail-panel]"));
        const sectionById = new Map(sections.map((section) => [section.id, section]));
        let progressFrame = 0;
        const activeSections = new Set();
        const activeOutlineTargets = new Set();
        let activeSectionId = "";

        function bindReviewMapInteractions() {
          document.querySelectorAll("[data-tab-group]").forEach((group) => {
            const buttons = Array.from(group.querySelectorAll("[data-tab-select]"));
            const panels = Array.from(group.querySelectorAll("[data-tab-panel]"));
            buttons.forEach((button) => {
              button.addEventListener("click", guard(() => {
                const selected = button.dataset.tabSelect || "";
                buttons.forEach((candidate) => {
                  candidate.setAttribute(
                    "aria-selected",
                    String(candidate.dataset.tabSelect === selected)
                  );
                });
                panels.forEach((panel) => {
                  panel.classList.toggle("is-active", panel.dataset.tabPanel === selected);
                });
              }));
            });
          });

          document.querySelectorAll("[data-role-filter-group]").forEach((group) => {
            const targetId = group.dataset.filterTarget || "";
            const table = document.getElementById(targetId);
            if (!table) return;
            const buttons = Array.from(group.querySelectorAll("[data-role-filter]"));
            const rows = Array.from(table.querySelectorAll("tbody tr[data-review-roles]"));
            buttons.forEach((button) => {
              button.addEventListener("click", guard(() => {
                const role = button.dataset.roleFilter || "all";
                buttons.forEach((candidate) => {
                  candidate.setAttribute(
                    "aria-pressed",
                    String(candidate.dataset.roleFilter === role)
                  );
                });
                rows.forEach((row) => {
                  const roles = (row.dataset.reviewRoles || "").split(" ");
                  const matches = role === "all" || roles.includes(role);
                  row.classList.toggle("is-match", role !== "all" && matches);
                  row.classList.toggle("is-dim", !matches);
                });
              }));
            });
          });

          document.querySelectorAll("[data-architecture-canvas]").forEach((canvas) => {
            const layers = Array.from(canvas.querySelectorAll("[data-architecture-layer]"));
            const nodes = Array.from(canvas.querySelectorAll("[data-architecture-focus]"));
            const reset = canvas.querySelector("[data-architecture-reset]");

            function focusLayer(layerId) {
              canvas.classList.toggle("has-focus", Boolean(layerId));
              layers.forEach((layer) => {
                layer.classList.toggle("is-focus", layer.dataset.architectureLayer === layerId);
              });
              if (reset) reset.hidden = !layerId;
            }

            nodes.forEach((node) => {
              node.addEventListener("click", guard(() => {
                const layerId = node.dataset.architectureFocus || "";
                const current = canvas.querySelector("[data-architecture-layer].is-focus");
                focusLayer(current?.dataset.architectureLayer === layerId ? "" : layerId);
              }));
            });
            if (reset) reset.addEventListener("click", guard(() => focusLayer("")));
          });

          if (document.querySelector("[data-review-map-view]")) {
            root.classList.add("diagram-enhanced");
          }
        }

        bindReviewMapInteractions();

        function updateReadingPosition() {
          progressFrame = 0;
          const maximum = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
          const ratio = Math.min(1, Math.max(0, window.scrollY / maximum));
          if (readingPosition) readingPosition.style.transform = `scaleX(${ratio})`;
        }

        function scheduleReadingPosition() {
          if (!progressFrame) progressFrame = window.requestAnimationFrame(guard(updateReadingPosition));
        }

        function targetIdFromLink(link) {
          const href = link.getAttribute("href") || "";
          try {
            return decodeURIComponent(href.startsWith("#") ? href.slice(1) : href);
          } catch (_error) {
            return "";
          }
        }

        function sectionForTarget(target) {
          if (!target) return null;
          if (target.matches("[data-section]")) return target;
          return target.closest("[data-section]");
        }

        function openDisclosureAncestors(target) {
          let ancestor = target?.parentElement || null;
          while (ancestor) {
            if (ancestor instanceof HTMLDetailsElement) ancestor.open = true;
            ancestor = ancestor.parentElement;
          }
        }

        function markActiveOutline(targetId) {
          outlineLinks.forEach((link) => {
            const active = targetIdFromLink(link) === targetId;
            link.dataset.active = String(active);
            link.setAttribute("aria-current", active ? "location" : "false");
            if (active) openDisclosureAncestors(link);
          });
        }

        function setActiveArticle(sectionId) {
          if (!sectionById.has(sectionId)) return;
          activeSectionId = sectionId;
          anchorLinks.forEach((link) => {
            const active = targetIdFromLink(link) === sectionId;
            link.dataset.active = String(active);
            link.setAttribute("aria-current", active ? "location" : "false");
          });
          railPanels.forEach((panel) => {
            panel.hidden = panel.dataset.railPanel !== sectionId;
          });
          const activePanel = railPanels.find(
            (panel) => panel.dataset.railPanel === sectionId
          );
          const activeOutline = outlineLinks.find(
            (link) => link.dataset.ownerSection === sectionId && link.dataset.active === "true"
          );
          const groupedOutline = activePanel?.querySelector("[data-appendix-rail-group]");
          if (!activeOutline && !groupedOutline) {
            const defaultOutline = outlineLinks.find((link) => link.dataset.ownerSection === sectionId);
            if (defaultOutline) markActiveOutline(targetIdFromLink(defaultOutline));
          }
        }

        function setActiveOutline(targetId) {
          const activeLink = outlineLinks.find((link) => targetIdFromLink(link) === targetId);
          if (!activeLink) return;
          const ownerSection = activeLink.dataset.ownerSection || "";
          if (ownerSection && ownerSection !== activeSectionId) setActiveArticle(ownerSection);
          markActiveOutline(targetId);
        }

        function targetFromHash(hash) {
          if (!hash || hash === "#") return sections[0] || null;
          try {
            return document.getElementById(decodeURIComponent(hash.slice(1)));
          } catch (_error) {
            return null;
          }
        }

        const outlineTargets = outlineLinks
          .map((link) => targetFromHash(link.getAttribute("href") || ""))
          .filter((target) => target !== null);

        function revealTarget(target) {
          if (!target || reducedMotion) return;
          target.querySelectorAll("[data-reveal]").forEach((unit) => {
            unit.dataset.revealState = "visible";
          });
          if (target.matches("[data-reveal]")) target.dataset.revealState = "visible";
        }

        function activateTarget(target) {
          const section = sectionForTarget(target);
          if (!section) return;
          openDisclosureAncestors(target);
          setActiveArticle(section.id);
          setActiveOutline(target.id);
        }

        function navigate(hash, behavior) {
          const target = targetFromHash(hash);
          if (!target) return;
          revealTarget(target);
          activateTarget(target);
          target.scrollIntoView({ behavior: reducedMotion ? "auto" : behavior, block: "start" });
        }

        [...anchorLinks, ...outlineLinks].forEach((link) => {
          link.addEventListener("click", guard((event) => {
            const hash = link.getAttribute("href") || "#";
            const target = targetFromHash(hash);
            if (!target) return;
            event.preventDefault();
            window.history.pushState(null, "", hash);
            navigate(hash, "smooth");
          }));
        });

        document.querySelectorAll("[data-copy-code]").forEach((button) => {
          button.addEventListener("click", guard(() => {
            const code = button.closest(".code-block")?.querySelector("code")?.textContent || "";
            if (navigator.clipboard && code) navigator.clipboard.writeText(code).catch(() => {});
            button.textContent = "已复制";
            window.setTimeout(() => { button.textContent = "复制"; }, 1300);
          }));
        });

        window.addEventListener("scroll", scheduleReadingPosition, { passive: true });
        window.addEventListener("resize", scheduleReadingPosition, { passive: true });
        window.addEventListener("popstate", guard(() => navigate(window.location.hash, "auto")));
        window.addEventListener("hashchange", guard(() => navigate(window.location.hash, "auto")));

        if (!reducedMotion && "IntersectionObserver" in window) {
          root.classList.add("motion-ready");
          revealUnits.forEach((unit) => { unit.dataset.revealState = "pending"; });
          const revealObserver = new IntersectionObserver(guard((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.dataset.revealState = "visible";
              revealObserver.unobserve(entry.target);
            });
          }), { rootMargin: "0px 0px -10% 0px", threshold: 0.08 });
          revealUnits.forEach((unit) => revealObserver.observe(unit));
        } else {
          revealAll();
        }

        if ("IntersectionObserver" in window) {
          const activeObserver = new IntersectionObserver(guard((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                activeSections.add(entry.target.id);
              } else {
                activeSections.delete(entry.target.id);
              }
            });
            const active = [...sections].reverse().find((section) => activeSections.has(section.id));
            if (active) setActiveArticle(active.id);
          }), { rootMargin: "-56px 0px -72% 0px", threshold: 0 });
          sections.forEach((section) => activeObserver.observe(section));

          const outlineObserver = new IntersectionObserver(guard((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                activeOutlineTargets.add(entry.target.id);
              } else {
                activeOutlineTargets.delete(entry.target.id);
              }
            });
            const active = outlineTargets
              .filter((target) => activeOutlineTargets.has(target.id))
              .sort((left, right) => left.getBoundingClientRect().top - right.getBoundingClientRect().top)
              .at(-1);
            if (active) setActiveOutline(active.id);
          }), { rootMargin: "-56px 0px -68% 0px", threshold: 0 });
          outlineTargets.forEach((target) => outlineObserver.observe(target));
        }

        scheduleReadingPosition();
        window.requestAnimationFrame(guard(() => {
          const target = targetFromHash(window.location.hash);
          if (target) {
            revealTarget(target);
            activateTarget(target);
          } else if (sections[0]) {
            activateTarget(sections[0]);
          }
        }));
      } catch (_error) {
        failMotion();
      }
    })();
  </script>
</body>
</html>
